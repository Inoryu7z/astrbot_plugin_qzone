{
    "manage_group": {
        "description": "管理群",
        "type": "string",
        "hint": "bot收到的投稿将在管理群里审批, 不填则将审批信息私发给bot管理员"
    },
    "pillowmd_style_dir": {
        "description": "Pillowmd样式目录路径",
        "type": "string",
        "hint": "例如 C:\\styles\\my-style 或 /data/styles/default, 留空则使用默认样式。pillowmd用于渲染说说内容",
        "default": ""
    },
    "llm": {
        "description": "LLM模块配置",
        "type": "object",
        "hint": "",
        "items": {
            "post_provider_id": {
                "description": "写说说用的LLM提供商",
                "hint": "留空或者填写的提供商不存在时, 则使用当前正在使用的LLM提供商",
                "type": "string",
                "default": "",
                "_special": "select_provider"
            },
            "post_prompt": {
                "description": "写说说用的llm提示词",
                "type": "text",
                "hint": "强烈建议自行根据Bot人格进行改写, 从而达到更好的效果",
                "default": "写一条QQ空间说说，内容自由发挥：可以是碎碎念、吐槽、分享、感慨、或任何你想说的。用你自己的方式说话，保持真实感，不要像写作文。不要使用emoji。"
            },
            "comment_provider_id": {
                "description": "评论说说用的LLM提供商",
                "hint": "留空或者填写的提供商不存在时, 则使用当前正在使用的LLM提供商",
                "type": "string",
                "default": "",
                "_special": "select_provider"
            },
            "comment_prompt": {
                "description": "评论说说用的llm提示词",
                "type": "text",
                "hint": "强烈建议自行根据Bot人格进行改写, 从而达到更好的效果",
                "default": "根据帖子内容，用你自然的说话方式评论。简短、贴题、像朋友聊天。不要使用emoji。"
            },
            "reply_provider_id": {
                "description": "回复评论用的LLM提供商",
                "hint": "留空或者填写的提供商不存在时, 则使用当前正在使用的LLM提供商",
                "type": "string",
                "default": "",
                "_special": "select_provider"
            },
            "reply_prompt": {
                "description": "回复评论用的llm提示词",
                "type": "text",
                "hint": "强烈建议自行根据Bot人格进行改写, 从而达到更好的效果",
                "default": "回复评论。根据评论内容和你的性格来回应，简短自然即可。不要使用emoji。"
            }
        }
    },
    "source": {
        "description": "数据来源配置",
        "type": "object",
        "hint": "",
        "items": {
            "ignore_groups": {
                "description": "忽略的群聊列表",
                "hint": "若群聊被忽略, Bot将不会从该群聊抽取聊天记录来写说说。建议将信息比较敏感的群聊加入此列表",
                "type": "list",
                "default": []
            },
            "ignore_users": {
                "description": "忽略的用户列表",
                "type": "list",
                "hint": "Bot在随机触发读说说时, 如果发现用户未开放空间, 则自动将该用户加入忽略列表, 下次不再处理该用户",
                "default": []
            },
            "post_max_msg": {
                "description": "用于写说说的聊天记录的最大条数",
                "type": "int",
                "hint": "过长会爆上下文, 一般几百条足矣",
                "slider": {
                    "min": 100,
                    "max": 1000,
                    "step": 10
                },
                "default": 500
            }
        }
    },
    "trigger": {
        "description": "触发配置",
        "type": "object",
        "hint": "",
        "items": {
            "publish_cron": {
                "description": "自动发说说的基准触发时间",
                "type": "string",
                "hint": "使用 Cron 表达式（分 时 日 月 周）定义基准时间。例如 \"30 23 * * *\" 表示每天 23:30 为基准点；实际执行时间 = 基准点 ± 偏移秒数（随机）。留空表示禁用此功能",
                "default": "30 23 * * *"
            },
            "publish_offset": {
                "description": "自动发说说的时间偏移（秒）",
                "type": "int",
                "hint": "基于基准触发时间做随机前后浮动。设为 600 表示会在基准触发时间前后 600 秒内随机触发；设为 0 则严格按 cron 时间触发",
                "slider": {
                    "min": 0,
                    "max": 3600,
                    "step": 1
                },
                "default": 600
            },
            "comment_cron": {
                "description": "自动评论的基准触发时间",
                "type": "string",
                "hint": "注意此处评论的是 bot 好友们最近发的说说。使用 Cron 表达式定义基准时间；实际执行时间 = 基准点 ± 偏移秒数（随机）。留空表示禁用此功能",
                "default": "0 8 * * *"
            },
            "comment_offset": {
                "description": "自动评论的时间偏移（秒）",
                "type": "int",
                "hint": "基于基准触发时间做随机前后浮动。设为 600 表示会在基准触发时间前后 600 秒内随机触发；设为 0 则严格按 cron 时间触发",
                "slider": {
                    "min": 0,
                    "max": 3600,
                    "step": 1
                },
                "default": 600
            },
            "comment_latest_count": {
                "description": "定时评论时最多评论几条说说",
                "type": "int",
                "hint": "定时评论任务每次最多评论几条说说（只评论自己未评论过的）",
                "slider": {
                    "min": 1,
                    "max": 20,
                    "step": 1
                },
                "default": 3
            },
            "reply_cron": {
                "description": "自动回复评论的基准触发时间",
                "type": "string",
                "hint": "自动检查自己说说下的新评论并回复。使用 Cron 表达式定义基准时间；实际执行时间 = 基准点 ± 偏移秒数（随机）。留空表示禁用此功能",
                "default": ""
            },
            "reply_offset": {
                "description": "自动回复评论的时间偏移（秒）",
                "type": "int",
                "hint": "基于基准触发时间做随机前后浮动。设为 600 表示会在基准触发时间前后 600 秒内随机触发；设为 0 则严格按 cron 时间触发",
                "slider": {
                    "min": 0,
                    "max": 3600,
                    "step": 1
                },
                "default": 600
            },
            "auto_reply_prob": {
                "description": "收到新评论时自动回复的概率",
                "type": "float",
                "hint": "自己的说说收到评论或自己的评论被回复时，概率触发自动回复。推荐设得非常小，0表示禁用",
                "slider": {
                    "min": 0,
                    "max": 1,
                    "step": 0.0001
                },
                "default": 0
            },
            "max_reply_depth": {
                "description": "自动回复的最大深度",
                "type": "int",
                "hint": "限制自动回复的嵌套层数。1表示只回复一次（对方再回复则不再自动回复），0表示不限制",
                "slider": {
                    "min": 0,
                    "max": 10,
                    "step": 1
                },
                "default": 1
            },
            "read_prob": {
                "description": "聊天时触发评说说的概率",
                "type": "float",
                "hint": "用户在群聊、私聊时, Bot会随机评论说说。推荐设得非常小",
                "slider": {
                    "min": 0,
                    "max": 1,
                    "step": 0.0001
                },
                "default": 0.001
            },
            "send_admin": {
                "description": "触发评说说时仅通知管理员",
                "hint": "打开后, 渲染好的稿件将私发给bot管理员, 而不是直接发到群里",
                "type": "bool",
                "default": false
            },
            "like_when_comment": {
                "description": "评说说时是否自动点赞",
                "hint": "在评论完说说后会自动给此说说点赞",
                "type": "bool",
                "default": true
            }
        }
    },
    "cookies_str": {
        "description": "QQ Cookies",
        "type": "text",
        "hint": "选填, 用于维持QQ空间登录态, 留空则自动从 aiocqhttp 客户端获取",
        "default": ""
    },
    "timeout": {
        "description": "请求超时时间",
        "type": "int",
        "hint": "网络请求的超时时间, 单位秒",
        "slider": {
            "min": 5,
            "max": 120,
            "step": 1
        },
        "default": 30
    },
    "show_name": {
        "description": "是否显示昵称",
        "type": "bool",
        "hint": "通过稿件发布说说时, 是否在头部显示「来自 xxx 的投稿」, 若是匿名投稿者, 昵称会显示为「匿名者」",
        "default": true
    },
    "silent_approve": {
        "description": "静默模式",
        "type": "bool",
        "hint": "开启后, 投稿/过稿/拒稿/评说说/发说说等所有操作均不发送通知消息",
        "default": false
    },
    "daemon_port": {
        "description": "Daemon端口",
        "type": "int",
        "hint": "QQ空间守护进程的HTTP端口",
        "default": 18999
    },
    "keepalive_interval": {
        "description": "保活间隔",
        "type": "int",
        "hint": "Daemon保活检查间隔（秒）",
        "default": 120
    },
    "auto_start_daemon": {
        "description": "自动启动Daemon",
        "type": "bool",
        "hint": "插件加载时自动启动守护进程",
        "default": true
    },
    "auto_bind_cookie": {
        "description": "自动绑定Cookie",
        "type": "bool",
        "hint": "自动从OneBot获取QQ空间Cookie",
        "default": true
    },
    "cookie_domain": {
        "description": "Cookie域名",
        "type": "string",
        "hint": "",
        "default": "user.qzone.qq.com"
    },
    "admin_uins": {
        "description": "管理员QQ号",
        "type": "string",
        "hint": "管理员QQ号，逗号分隔",
        "default": ""
    },
    "user_agent": {
        "description": "User-Agent",
        "type": "string",
        "hint": "",
        "default": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36"
    },
    "render_publish_result": {
        "description": "渲染发布结果",
        "type": "bool",
        "hint": "将发布/评论/点赞结果渲染为QQ空间风格卡片图片",
        "default": true
    },
    "render_result_width": {
        "description": "渲染图片宽度",
        "type": "int",
        "hint": "",
        "default": 900
    },
    "comment_max_length": {
        "description": "评论最大长度",
        "type": "int",
        "hint": "LLM生成评论的最大字符数",
        "default": 60
    }
}